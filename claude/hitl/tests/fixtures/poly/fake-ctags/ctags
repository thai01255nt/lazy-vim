#!/usr/bin/env node
// Fake Universal Ctags for tests: replays recorded JSON tags (tags.jsonl) for the files named on stdin (-L -).
const fs = require("fs"), path = require("path");
const argv = process.argv.slice(2);
if (argv.includes("--version")) {
  process.stdout.write("Universal Ctags 6.1.0(p6.1.20240101.0), Copyright (C) 2015-2023 Universal Ctags Team\n" +
    "Universal Ctags is derived from Exuberant Ctags.\nOptional compiled features: +wildcards, +regex, +gnulib_regex, +iconv, +option-directory, +xpath, +json, +interactive, +yaml\n");
  process.exit(0);
}
if (argv.includes("--list-languages")) { process.stdout.write(["C", "C++", "Go", "Java", "Kotlin", "Ruby", "Rust", "Sh", "SQL", "Lua [disabled]"].join("\n") + "\n"); process.exit(0); }
if (process.env.FAKE_CTAGS_FAIL) { process.stderr.write("ctags: boom\n"); process.exit(2); }
const want = new Set(fs.readFileSync(0, "utf8").split("\n").filter(Boolean));
const tags = fs.readFileSync(path.join(__dirname, "tags.jsonl"), "utf8").split("\n").filter(Boolean).map((l) => JSON.parse(l));
for (const t of tags) if (want.has(t.path)) process.stdout.write(JSON.stringify({ _type: "tag", ...t }) + "\n");
