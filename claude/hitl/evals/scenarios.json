     "kind": "new"
    },
    {
     "file": "src/ratelimit/bucket_util.lua",
     "name": "refillBucket",
     "kind": "modify",
     "keep": [
      "local elapsedMs = math.max(0, options.nowMs - bucket.updatedAtMs)",
      "bucket.updatedAtMs = options.nowMs",
      "return added"
     ]
    },
    {
     "file": "src/ratelimit/bucket_util.lua",
     "name": "M.takeWithBurst",
     "kind": "new"
    },
    {
     "file": "src/ratelimit/take.lua",
     "name": "M.take",
     "kind": "existing",
     "keep": [
      "bucket_util.refillBucket({ bucket = bucket, nowMs = nowMs })",
      "bucket.tokens = bucket.tokens - count"
     ]
    }
   ],
