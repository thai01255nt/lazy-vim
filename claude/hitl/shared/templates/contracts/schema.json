{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "{name}.schema.json",
  "title": "{Name}",
  "description": "{what this payload or file is; serves {KEY}-R{n}}",
  "type": "object",
  "required": ["{field}"],
  "properties": {
    "{field}": { "type": "string", "description": "{meaning}" }
  },
  "additionalProperties": false
}
